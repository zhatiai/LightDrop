{
  "name": "lightdrop",
  "version": "1.0.0",
  "description": "LightDrop - 基于 TypeScript 的轻量高效跨设备文件与文本共享服务 (PWA 支持)",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"pnpm dev:server\" \"pnpm dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop lightdrop",
    "pm2:restart": "pm2 restart lightdrop",
    "pm2:logs": "pm2 logs lightdrop",
    "deploy": "pnpm build && (pm2 restart lightdrop || pm2 start ecosystem.config.cjs)",
    "deploy:service": "bash scripts/deploy.sh",
    "package": "bash scripts/package.sh",
    "uninstall:service": "bash scripts/uninstall.sh",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json"
  },
  "keywords": [
    "airdrop",
    "lightdrop",
    "lan-sharing",
    "pwa",
    "typescript",
    "file-transfer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.1.0",
    "mermaid": "^12.2.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.16",
    "tailwind-merge": "^3.0.2",
    "workbox-window": "^7.4.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/marked": "^6.0.0",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
